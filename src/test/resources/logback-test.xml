<?xml version="1.0" encoding="UTF-8"?>
<!-- Test logging: test steps + Kafka Streams state transitions, without the client config dumps -->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%15.15thread] %-30.30logger{0} : %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="com.github.schm1tz1" level="DEBUG"/>
    <logger name="org.apache.kafka.streams.KafkaStreams" level="INFO"/>
    <logger name="org.springframework.retry" level="DEBUG"/>

    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
