<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.4</version>
        <relativePath/>
    </parent>

    <groupId>com.github.schm1tz1</groupId>
    <artifactId>KStreamsSpringBoot</artifactId>
    <version>0.1</version>
    <packaging>jar</packaging>

    <name>Example Kafka Streams Spring Boot App</name>

    <properties>
        <java.version>17</java.version>
        <fmt-maven-plugin.version>2.27</fmt-maven-plugin.version>
        <jib-maven-plugin.version>3.5.2</jib-maven-plugin.version>
        <!-- set by the jdk24+ profile -->
        <unsafe.argLine></unsafe.argLine>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>com.spotify.fmt</groupId>
                <artifactId>fmt-maven-plugin</artifactId>
                <version>${fmt-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <phase>process-sources</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Daemonless image build on distroless (nonroot), no Dockerfile:
                 mvn package jib:buildTar  -> target/jib-image.tar
                 mvn package jib:build     -> push to registry (-Dimage=...) -->
            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
                <version>${jib-maven-plugin.version}</version>
                <configuration>
                    <from>
                        <image>gcr.io/distroless/java17-debian12:nonroot</image>
                        <!-- multi-arch only works with jib:build; for jib:buildTar pick one,
                             e.g. -Djib.from.platforms=linux/arm64 -->
                        <platforms>
                            <platform>
                                <architecture>amd64</architecture>
                                <os>linux</os>
                            </platform>
                            <platform>
                                <architecture>arm64</architecture>
                                <os>linux</os>
                            </platform>
                        </platforms>
                    </from>
                    <to>
                        <image>schmitzi/kstreams-spring-boot:${project.version}</image>
                    </to>
                    <container>
                        <!-- Spring Boot reads ./config/application.yml, so mount overrides at /app/config -->
                        <workingDirectory>/app</workingDirectory>
                        <jvmFlags>
                            <jvmFlag>-XX:MaxRAMPercentage=75</jvmFlag>
                        </jvmFlags>
                        <ports>
                            <port>8080</port>
                        </ports>
                    </container>
                </configuration>
            </plugin>
            <!-- Load Mockito as -javaagent instead of self-attaching (JDK 21+ warns, future JDKs block):
                 dependency:properties exposes ${org.mockito:mockito-core:jar} -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-javaagent:${org.mockito:mockito-core:jar} ${unsafe.argLine}</argLine>
                </configuration>
            </plugin>
            <!-- *IT tests (embedded broker, slow) run in `mvn verify` only -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <argLine>${unsafe.argLine}</argLine>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-streams</artifactId>
        </dependency>
        <!-- @Retryable / @Backoff; AOP starter provides the proxying spring-retry needs -->
        <dependency>
            <groupId>org.springframework.retry</groupId>
            <artifactId>spring-retry</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- Metrics/health over HTTP: /actuator/prometheus, /actuator/health/{liveness,readiness} -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-streams-test-utils</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!-- JDK 24+ warns when Kafka's ByteBufferUnmapper (embedded broker index files) calls the
             terminally deprecated sun.misc.Unsafe::invokeCleaner (JEP 498). The flag does not exist
             before JDK 23, so only set it on newer JDKs. -->
        <profile>
            <id>jdk24+</id>
            <activation>
                <jdk>[24,)</jdk>
            </activation>
            <properties>
                <unsafe.argLine>--sun-misc-unsafe-memory-access=allow</unsafe.argLine>
            </properties>
        </profile>
    </profiles>

</project>
